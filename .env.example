# PostgreSQL bağlantı string'i
# Neon örneği: postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/dbname?sslmode=require
# Lokal örnek:   postgresql://postgres:postgres@127.0.0.1:5432/app_db
DATABASE_URL=

# Oturum (JWT) imzalama anahtarı — ÜRETİMDE ZORUNLU, en az 32 karakter.
# Üretim örneği: openssl rand -base64 48
# Tanımlanmazsa üretimde tüm oturumlar reddedilir (fail-closed).
SESSION_SECRET=

# İlk kurulum (seed) parolaları — ÜRETİMDE ZORUNLU, en az 12 karakter.
# Tanımlanmazsa üretimde varsayılan hesaplar OLUŞTURULMAZ.
# Yalnızca ilk seed içindir; sonrasında değiştirmenin mevcut kullanıcıya etkisi yoktur.
SEED_ADMIN_PASSWORD=
SEED_STORE_PASSWORD=

# --- Faz 6 (opsiyonel) ---
# Sentry hata izleme (tanımlamazsanız SDK yüklenmez)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Log seviyesi (varsayılan: üretim=info, geliştirme=debug)
LOG_LEVEL=

# --- Arbitraj V2 (opsiyonel) ---
# Keepa API (api.keepa.com) — yoksa mock veri deterministik döner, kota harcanmaz
# Almak için: https://keepa.com/#!api  — aylık token kotası, 1 token = 1 ASIN
KEEPA_API_KEY=
# Keepa domain: 1=US, 3=DE, 8=UK vs. (varsayılan 1)
KEEPA_API_DOMAIN=1
# Crawler — opsiyonel Python Scrapling mikro-servisi (ayrıştırmak isterseniz)
# Vercel Node tek başına stealth JS crawler çalıştırır; bu URL set ise
# 403/bot challenge durumunda oraya fallback gider (örn. Render/Fly/Railway).
SCRAPLING_SERVICE_URL=
# Node uygulaması ve Python crawler arasında en az 32 karakterlik paylaşımlı sır
SCRAPLING_SERVICE_TOKEN=
# İsteğe bağlı: crawler'ın yalnız bu public alan adlarına navigasyon yapmasına izin ver
CRAWLER_ALLOWED_HOSTS=
# ROI eşikleri varsayılan 25/38 — panelden değiştirilebilir (app_settings tablosu)
# Bu ENV değerleri artık kullanılmaz; DB + /api/settings tek kaynak.
